{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorkPulse",
  "version": "0.1.0",
  "identifier": "com.workpulse.companion",
  "build": {
    "beforeDevCommand": "npm run --workspace=ui dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run --workspace=ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "WorkPulse",
        "width": 420,
        "height": 600,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": true,
        "shadow": false,
        "visible": true,
        "additionalBrowserArgs": "--renderer-process-limit=1 --disable-features=TranslateUI,MediaSessionService --disable-background-networking"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
